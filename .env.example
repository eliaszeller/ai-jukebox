# Copy to .env, then enter the class key on the server only.
CLASS_API_KEY=replace_with_class_key
PORT=3000
HOST=127.0.0.1
# For remote deployment set HOST=0.0.0.0 and a strong APP_PASSWORD.
# APP_PASSWORD=replace_with_a_strong_password
# Alternatively point to the original endpoint file, outside the app:
# CLASS_ENDPOINTS_FILE=/absolute/path/to/class-endpoints.txt
