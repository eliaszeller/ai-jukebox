# Set in your shell or through the hosting provider's secret manager.
# Never paste real credentials into tracked files.
CLASS_API_KEY=your_class_api_key
# Hosting only: a separate random server-side secret for audio download signatures.
# Local development automatically creates an in-memory signing secret.
MEDIA_SIGNING_KEY=your_random_signing_secret
# Optional. Each URL must use the required class port.
TEXT_BASE_URL=http://your-class-host:9001
ART_BASE_URL=http://your-class-host:9006
MUSIC_BASE_URL=http://your-class-host:9007
SPEECH_BASE_URL=http://your-class-host:9008
PORT=4173
